# ==============================================================================
# LABELIQ ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your values. Never commit actual secret keys.

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. GEMINI AI VISION & SCANNER ENGINE
# ------------------------------------------------------------------------------
# In Google AI Studio, this is injected automatically in runtime.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. FIREBASE WEB CLIENT CONFIGURATION (PUBLIC)
# ------------------------------------------------------------------------------
# Obtained from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN SDK CONFIGURATION (PRIVATE SERVER SECRETS)
# ------------------------------------------------------------------------------
# Option A (Recommended for production): Service Account Credentials
# Obtained from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Option B: Path to downloaded Service Account JSON file (Alternative to above)
# GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# ------------------------------------------------------------------------------
# 5. ADMINISTRATOR AUTHORIZATION & RBAC
# ------------------------------------------------------------------------------
# Comma-separated list of authorized administrator emails
# Users logged in with these emails are automatically granted administrator rights
ADMIN_EMAILS="jahnvith80@gmail.com"

# Interim administrator passcode fallback
ADMIN_PASSCODE=""
